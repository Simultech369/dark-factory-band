# BAND Platform API Credentials
# Get these from https://app.band.ai

# Your Band Account API Key (used by all 3 agents if individual keys are not set)
BAND_API_KEY=your_band_api_key_here

# Agent UUIDs from app.band.ai Agent Settings:
BAND_PLANNER_ID=your_planner_agent_uuid_here
BAND_CODER_ID=your_coder_agent_uuid_here
BAND_CRITIC_ID=your_critic_agent_uuid_here

# (Optional) If your BAND account prefixes handles with your username, e.g. @username.darkfactoryplanner:
# BAND_PLANNER_HANDLE=@yourusername.darkfactoryplanner
# BAND_CODER_HANDLE=@yourusername.darkfactorycoder
# BAND_CRITIC_HANDLE=@yourusername.darkfactorycritic
